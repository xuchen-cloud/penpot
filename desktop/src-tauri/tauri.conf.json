{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penpot Desktop",
  "version": "2.17.0",
  "identifier": "cloud.xuchen.penpot.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Penpot Desktop",
        "width": 1040,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "../../plugins/apps/icons-plugin/src/assets/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
