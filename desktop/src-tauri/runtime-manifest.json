{
  "schemaVersion": 1,
  "targets": {
    "aarch64-apple-darwin": {
      "components": [
        {
          "id": "postgres",
          "executable": "postgres/bin/postgres",
          "requiredFiles": [
            "postgres/bin/initdb",
            "postgres/bin/createdb",
            "postgres/bin/pg_ctl",
            "postgres/bin/pg_dump",
            "postgres/bin/psql"
          ]
        },
        {
          "id": "cache",
          "executable": "valkey/bin/valkey-server"
        },
        {
          "id": "media-processor",
          "executable": "node/bin/node",
          "requiredFiles": [
            "media-processor/index.js",
            "media-processor/package.json",
            "tools/bin/fontforge",
            "tools/bin/sfnt2woff",
            "tools/bin/woff2sfnt",
            "tools/bin/woff2_decompress"
          ]
        },
        {
          "id": "backend",
          "executable": "jre/bin/java",
          "requiredFiles": ["backend/penpot.jar"],
          "dependsOn": ["postgres", "cache", "media-processor"]
        },
        {
          "id": "exporter",
          "executable": "node/bin/node",
          "requiredFiles": [
            "exporter/app.js",
            "exporter/package.json",
            "exporter/resources/wasm/render-wasm.js",
            "exporter/resources/wasm/render-wasm.wasm",
            "frontend/index.html",
            "frontend/render.html",
            "frontend/js/render-wasm.wasm",
            "chromium/Chromium.app/Contents/MacOS/Chromium",
            "tools/bin/convert",
            "tools/bin/potrace"
          ],
          "dependsOn": ["backend", "cache"]
        }
      ]
    },
    "x86_64-pc-windows-msvc": {
      "components": [
        {
          "id": "postgres",
          "executable": "postgres/bin/postgres.exe",
          "requiredFiles": [
            "postgres/bin/initdb.exe",
            "postgres/bin/createdb.exe",
            "postgres/bin/pg_ctl.exe",
            "postgres/bin/pg_dump.exe",
            "postgres/bin/psql.exe"
          ]
        },
        {
          "id": "cache",
          "executable": "garnet/GarnetServer.exe"
        },
        {
          "id": "media-processor",
          "executable": "node/node.exe",
          "requiredFiles": [
            "media-processor/index.js",
            "media-processor/package.json",
            "tools/fontforge/bin/fontforge.exe",
            "tools/woff/sfnt2woff.exe",
            "tools/woff/woff2sfnt.exe",
            "tools/woff2/woff2_decompress.exe"
          ]
        },
        {
          "id": "backend",
          "executable": "jre/bin/java.exe",
          "requiredFiles": ["backend/penpot.jar"],
          "dependsOn": ["postgres", "cache", "media-processor"]
        },
        {
          "id": "exporter",
          "executable": "node/node.exe",
          "requiredFiles": [
            "exporter/app.js",
            "exporter/package.json",
            "exporter/resources/wasm/render-wasm.js",
            "exporter/resources/wasm/render-wasm.wasm",
            "frontend/index.html",
            "frontend/render.html",
            "frontend/js/render-wasm.wasm",
            "chromium/chrome.exe",
            "tools/imagemagick/magick.exe",
            "tools/potrace/potrace.exe"
          ],
          "dependsOn": ["backend", "cache"]
        }
      ]
    }
  }
}
