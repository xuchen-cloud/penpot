{
  "name": "web-to-penpot-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check src public index.html README.md package.json tsconfig.json vite.config.ts",
    "package": "pnpm run build && node scripts/package.mjs",
    "copy:offline": "pnpm run build && node scripts/copy-offline.mjs"
  },
  "dependencies": {
    "@penpot/plugin-types": "workspace:*"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
